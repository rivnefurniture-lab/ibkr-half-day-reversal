# The dashboard listens locally by default.
DASHBOARD_PORT=8765

# Set to true only if IB Gateway/TWS is normally running before the dashboard.
IBKR_AUTO_CONNECT=false

# Historical backtests only. Keep the real value in .env, which is gitignored.
# DATABENTO_API_KEY=db-...

# Keep this commented out through development and paper trading.
# Live mode remains unavailable unless this exact value is present at startup.
# IBKR_LIVE_UNLOCK=YES_I_UNDERSTAND
